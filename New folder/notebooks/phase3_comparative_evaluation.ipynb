    "    if state_image_id and re.match(r\"^[ab]_\\d{3}$\", state_image_id):\n",
    "        with open(STATE_TRACKER_FILEPATH, \"w\") as f:\n",
    "            yaml.safe_dump({\"LAST_PROCESSED_IMAGE_ID\": state_image_id}, f)\n",
    "\n",
    "phase_name = cfg[\"PHASE_NAME\"]\n",
    "N = cfg[\"BATCH_SIZE\"]\n",
    "current_img_id = loadstate_last_processed_image()\n",
    "current_filename = f\"{current_img_id}_orig.png\"\n",
    "\n",
    "# DCTroy configuration (Proposed Method)\n",
    "dctroy_frequency_weighting = cfg[\"DCTROY\"][\"FREQUENCY_WEIGHTING\"]\n",
    "dctroy_decay_strength = cfg[\"DCTROY\"][\"FREQUENCY_WEIGHT_DECAY\"]\n",
    "dctroy_eps = cfg[\"DCTROY\"][\"EPS\"]\n",
    "dctroy_alpha = cfg[\"DCTROY\"][\"ALPHA\"]\n",
    "dctroy_iters = cfg[\"DCTROY\"][\"ITERS\"]\n",
    "dctroy_jpeg_quality = cfg[\"DCTROY\"][\"JPEG_QUALITY\"]\n",
    "\n",
    "# Baseline configurations (Pixel-space methods)\n",
    "photoguard_eps = cfg[\"PHOTOGUARD\"][\"EPS\"]\n",
    "photoguard_alpha = cfg[\"PHOTOGUARD\"][\"ALPHA\"]\n",
    "photoguard_iters = cfg[\"PHOTOGUARD\"][\"ITERS\"]\n",
    "\n",
    "mist_eps = cfg[\"MIST\"][\"EPS\"]\n",
    "mist_alpha = cfg[\"MIST\"][\"ALPHA\"]\n",
    "mist_iters = cfg[\"MIST\"][\"ITERS\"]\n",
    "\n",
    "diffusionguard_eps = cfg[\"DIFFUSIONGUARD\"][\"EPS\"]\n",
    "diffusionguard_alpha = cfg[\"DIFFUSIONGUARD\"][\"ALPHA\"]\n",
    "diffusionguard_iters = cfg[\"DIFFUSIONGUARD\"][\"ITERS\"]\n",
    "\n",
    "# Dataset paths\n",
    "dataset_root = Path(cfg[\"DATASET\"][\"BASE_PATH\"])\n",
    "metadata_dir = cfg[\"DATASET\"][\"METADATA_DIR_NAME\"]\n",
    "# TEMPORARY: Using local metadata file instead of Google Sheets for testing\n",`n    "# dataset_metadata_path = cfg[\\"DATASET\\"][\\"GSHEET_METADATA_FILE\\"]\n",`n    "dataset_metadata_path = dataset_root / cfg[\\"DATASET\\"][\\"METADATA_FILE_NAME\\"]\n",
    "dataset_img_src_path = Path(dataset_root / cfg[\"DATASET\"][\"SRC_DIR_NAME\"])\n",
    "dataset_img_src_orig_path = Path(dataset_img_src_path / cfg[\"DATASET\"][\"ORIG_DIR_NAME\"])\n",
    "dataset_img_src_edited_path = Path(dataset_img_src_path / cfg[\"DATASET\"][\"EDIT_DIR_NAME\"])\n",
    "\n",
    "# Results paths\n",
    "results_root = Path(cfg[\"RESULTS\"][\"BASE_PATH\"])\n",
