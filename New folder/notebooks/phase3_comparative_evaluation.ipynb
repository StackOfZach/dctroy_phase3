  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4a4c3d28",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Combine all protected images (DCTroy + 3 Baselines) for batch editing\n",
    "img_to_be_edited_paths = [\n",
    "    # DCTroy protected images\n",
    "    *img_dctroy_protected_orig_paths,\n",
    "    *img_dctroy_protected_compressed_orig_paths,\n",
    "    *img_dctroy_protected_purified_orig_paths,\n",
    "    # Photoguard protected images\n",
    "    *img_photoguard_protected_orig_paths,\n",
    "    *img_photoguard_protected_compressed_orig_paths,\n",
    "    *img_photoguard_protected_purified_orig_paths,\n",
    "    # MIST protected images\n",
    "    *img_mist_protected_orig_paths,\n",
    "    *img_mist_protected_compressed_orig_paths,\n",
    "    *img_mist_protected_purified_orig_paths,\n",
    "    # DiffusionGuard protected images\n",
    "    *img_diffusionguard_protected_orig_paths,\n",
    "    *img_diffusionguard_protected_compressed_orig_paths,\n",
    "    *img_diffusionguard_protected_purified_orig_paths,\n",
    "]\n",
    "\n",
    "# Repeat edit prompts for each variant\n",
    "# 3 variants (protected, compressed, purified) × 4 methods (dctroy + 3 baselines) = 12x\n",
    "edit_prompts_expanded = edit_prompts * 12\n",
    "\n",
    "print(f\"Total images to edit: {len(img_to_be_edited_paths)}\")\n",
    "print(f\"Total prompts: {len(edit_prompts_expanded)}\")\n",
    "print(f\"Methods: DCTroy, Photoguard, MIST, DiffusionGuard\")\n",
    "print(f\"Variants per method: protected, compressed, purified\")"
   ]
