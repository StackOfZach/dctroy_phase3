   "metadata": {},
   "source": [
    "## Create the image batch editing generator"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8fe1870d",
   "metadata": {},
   "outputs": [],
   "source": [
    "from utils.diffusion_model import edit_images_with_ip2p_batch_looping_generator\n",
    "\n",
    "edited_images_generator = edit_images_with_ip2p_batch_looping_generator(\n",
    "    image_paths=img_to_be_edited_paths,\n",
    "    instructions=edit_prompts_expanded,\n",
    "    ip2p_pipe=ip2p_pipeline,\n",
    ")\n",
    "\n",
    "write_log(logger, \"[CREATING EDIT GENERATORS]\\n\", verbose=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0a38bd38",
   "metadata": {},
   "source": [
    "## Generate the edited images for both methods"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4586d52c",
   "metadata": {},
   "outputs": [],
   "source": [
    "from collections import defaultdict\n",
    "\n",
    "# Edited images dictionaries for each method\n",
    "dctroy_edited_images_path_dict = defaultdict(list)\n",
    "photoguard_edited_images_path_dict = defaultdict(list)\n",
    "mist_edited_images_path_dict = defaultdict(list)\n",
    "diffusionguard_edited_images_path_dict = defaultdict(list)\n",
    "\n",
    "write_log(logger, \"[GENERATING EDITED IMAGES] Starting IP2P editing...\\n\", verbose=True)\n",
    "\n",
    "for i, edited_img in enumerate(edited_images_generator):\n",
    "    display(edited_img)\n",
    "    print(f\"Prompt: {edit_prompts_expanded[i]}\")\n",
    "    \n",
    "    img_id = img_id_list[i % len(img_id_list)]\n",
    "    \n",
    "    # Determine which method (DCTroy, Photoguard, MIST, DiffusionGuard)\n",
    "    images_per_method = len(img_to_be_edited_paths) // 4\n",
    "    method_idx = i // images_per_method\n",
    "    \n",
    "    # Determine variant (protected, compressed, purified)\n",
    "    variant_idx = (i % images_per_method) // len(img_id_list)\n",
    "    variant_names = [\"protected\", \"compressed\", \"purified\"]\n",
    "    variant_name = variant_names[variant_idx]\n",
    "    \n",
    "    # Select method and paths\n",
    "    if method_idx == 0:\n",
    "        method_name = \"dctroy\"\n",
    "        base_path = results_dctroy_path\n",
    "        edited_images_dict = dctroy_edited_images_path_dict\n",
    "    elif method_idx == 1:\n",
    "        method_name = \"photoguard\"\n",
    "        base_path = results_photoguard_path\n",
    "        edited_images_dict = photoguard_edited_images_path_dict\n",
    "    elif method_idx == 2:\n",
    "        method_name = \"mist\"\n",
    "        base_path = results_mist_path\n",
    "        edited_images_dict = mist_edited_images_path_dict\n",
    "    else:\n",
    "        method_name = \"diffusionguard\"\n",
    "        base_path = results_diffusionguard_path\n",
    "        edited_images_dict = diffusionguard_edited_images_path_dict\n",
    "    \n",
    "    # Define save path\n",
    "    edited_img_save_path = Path(\n",
    "        f\"{base_path}/{variant_name}/edited/{img_id}_{method_name}_{variant_name}_edited.png\"\n",
    "    )\n",
    "    \n",
    "    edited_images_dict[variant_name].append(edited_img_save_path)\n",
    "    \n",
    "    print(f\"Saving to: {edited_img_save_path}\")\n",
    "    save_image_lossless(edited_img, edited_img_save_path)\n",
    "\n",
    "write_log(logger, \"[EDIT FINISHED]\\n\", verbose=True)"
   ]
  },
