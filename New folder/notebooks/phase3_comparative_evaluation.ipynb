    ")\n",
    "\n",
    "write_log(logger, \"[EVALUATION] Starting 4-way comparative evaluation (DCTroy vs 3 Baselines)...\\n\", verbose=True)\n",
    "\n",
    "for i in range(len(img_src_orig_paths)):\n",
    "    img_id = img_id_list[i]\n",
    "    \n",
    "    # Load source images\n",
    "    img_src_orig = Image.open(img_src_orig_paths[i]).resize((512, 512))\n",
    "    img_src_edited = Image.open(img_src_edited_paths[i]).resize((512, 512))\n",
    "    \n",
    "    # ============================ DCTroy Evaluation ============================\n",
    "    img_dctroy_protected_orig = Image.open(img_dctroy_protected_orig_paths[i])\n",
    "    img_dctroy_protected_edited = Image.open(dctroy_edited_images_path_dict[\"protected\"][i])\n",
    "    img_dctroy_compressed_edited = Image.open(dctroy_edited_images_path_dict[\"compressed\"][i])\n",
    "    img_dctroy_purified_edited = Image.open(dctroy_edited_images_path_dict[\"purified\"][i])\n",
    "    \n",
    "    dctroy_ssim, dctroy_psnr, dctroy_vifp = evaluate_imperceptibility(img_src_orig, img_dctroy_protected_orig)\n",
    "    dctroy_lpips = evaluate_lpips(img_src_edited, img_dctroy_protected_edited)\n",
    "    (dctroy_compressed_lpips_degradation, dctroy_compressed_lpips,\n",
    "     dctroy_purified_lpips_degradation, dctroy_purified_lpips) = evaluate_robustness(\n",
    "        img_src_edited, img_dctroy_protected_edited, \n",
    "        img_dctroy_compressed_edited, img_dctroy_purified_edited, verbose=False\n",
    "    )\n",
    "    \n",
    "    dctroy_results = ExperimentResult(\n",
    "        img_id=f\"{img_id}_dctroy\",\n",
    "        frequency_weighting=dctroy_frequency_weighting,\n",
    "        lpips=dctroy_lpips, ssim=dctroy_ssim, psnr=dctroy_psnr, vifp=dctroy_vifp,\n",
    "        compression_lpips=dctroy_compressed_lpips,\n",
    "        compression_lpips_degradation=dctroy_compressed_lpips_degradation,\n",
    "        purification_lpips=dctroy_purified_lpips,\n",
    "        purification_lpips_degradation=dctroy_purified_lpips_degradation,\n",
    "    )\n",
    "    write_results_csv(experiment_result_save_path, dctroy_results)\n",
    "    \n",
    "    # ============================ Photoguard Evaluation ============================\n",
    "    img_photoguard_protected_orig = Image.open(img_photoguard_protected_orig_paths[i])\n",
    "    img_photoguard_protected_edited = Image.open(photoguard_edited_images_path_dict[\"protected\"][i])\n",
    "    img_photoguard_compressed_edited = Image.open(photoguard_edited_images_path_dict[\"compressed\"][i])\n",
    "    img_photoguard_purified_edited = Image.open(photoguard_edited_images_path_dict[\"purified\"][i])\n",
    "    \n",
    "    photoguard_ssim, photoguard_psnr, photoguard_vifp = evaluate_imperceptibility(img_src_orig, img_photoguard_protected_orig)\n",
    "    photoguard_lpips = evaluate_lpips(img_src_edited, img_photoguard_protected_edited)\n",
    "    (photoguard_compressed_lpips_degradation, photoguard_compressed_lpips,\n",
    "     photoguard_purified_lpips_degradation, photoguard_purified_lpips) = evaluate_robustness(\n",
    "        img_src_edited, img_photoguard_protected_edited,\n",
    "        img_photoguard_compressed_edited, img_photoguard_purified_edited, verbose=False\n",
    "    )\n",
    "    \n",
    "    photoguard_results = ExperimentResult(\n",
    "        img_id=f\"{img_id}_photoguard\",\n",
    "        frequency_weighting=\"pixel_space\",\n",
    "        lpips=photoguard_lpips, ssim=photoguard_ssim, psnr=photoguard_psnr, vifp=photoguard_vifp,\n",
    "        compression_lpips=photoguard_compressed_lpips,\n",
    "        compression_lpips_degradation=photoguard_compressed_lpips_degradation,\n",
    "        purification_lpips=photoguard_purified_lpips,\n",
    "        purification_lpips_degradation=photoguard_purified_lpips_degradation,\n",
    "    )\n",
    "    write_results_csv(experiment_result_save_path, photoguard_results)\n",
    "    \n",
    "    # ============================ MIST Evaluation ============================\n",
    "    img_mist_protected_orig = Image.open(img_mist_protected_orig_paths[i])\n",
    "    img_mist_protected_edited = Image.open(mist_edited_images_path_dict[\"protected\"][i])\n",
    "    img_mist_compressed_edited = Image.open(mist_edited_images_path_dict[\"compressed\"][i])\n",
    "    img_mist_purified_edited = Image.open(mist_edited_images_path_dict[\"purified\"][i])\n",
    "    \n",
    "    mist_ssim, mist_psnr, mist_vifp = evaluate_imperceptibility(img_src_orig, img_mist_protected_orig)\n",
    "    mist_lpips = evaluate_lpips(img_src_edited, img_mist_protected_edited)\n",
    "    (mist_compressed_lpips_degradation, mist_compressed_lpips,\n",
    "     mist_purified_lpips_degradation, mist_purified_lpips) = evaluate_robustness(\n",
    "        img_src_edited, img_mist_protected_edited,\n",
    "        img_mist_compressed_edited, img_mist_purified_edited, verbose=False\n",
    "    )\n",
    "    \n",
    "    mist_results = ExperimentResult(\n",
    "        img_id=f\"{img_id}_mist\",\n",
    "        frequency_weighting=\"pixel_space\",\n",
    "        lpips=mist_lpips, ssim=mist_ssim, psnr=mist_psnr, vifp=mist_vifp,\n",
    "        compression_lpips=mist_compressed_lpips,\n",
    "        compression_lpips_degradation=mist_compressed_lpips_degradation,\n",
    "        purification_lpips=mist_purified_lpips,\n",
    "        purification_lpips_degradation=mist_purified_lpips_degradation,\n",
    "    )\n",
    "    write_results_csv(experiment_result_save_path, mist_results)\n",
    "    \n",
    "    # ============================ DiffusionGuard Evaluation ============================\n",
    "    img_diffusionguard_protected_orig = Image.open(img_diffusionguard_protected_orig_paths[i])\n",
    "    img_diffusionguard_protected_edited = Image.open(diffusionguard_edited_images_path_dict[\"protected\"][i])\n",
    "    img_diffusionguard_compressed_edited = Image.open(diffusionguard_edited_images_path_dict[\"compressed\"][i])\n",
    "    img_diffusionguard_purified_edited = Image.open(diffusionguard_edited_images_path_dict[\"purified\"][i])\n",
    "    \n",
    "    diffusionguard_ssim, diffusionguard_psnr, diffusionguard_vifp = evaluate_imperceptibility(img_src_orig, img_diffusionguard_protected_orig)\n",
    "    diffusionguard_lpips = evaluate_lpips(img_src_edited, img_diffusionguard_protected_edited)\n",
    "    (diffusionguard_compressed_lpips_degradation, diffusionguard_compressed_lpips,\n",
    "     diffusionguard_purified_lpips_degradation, diffusionguard_purified_lpips) = evaluate_robustness(\n",
    "        img_src_edited, img_diffusionguard_protected_edited,\n",
    "        img_diffusionguard_compressed_edited, img_diffusionguard_purified_edited, verbose=False\n",
    "    )\n",
    "    \n",
    "    diffusionguard_results = ExperimentResult(\n",
    "        img_id=f\"{img_id}_diffusionguard\",\n",
    "        frequency_weighting=\"pixel_space\",\n",
    "        lpips=diffusionguard_lpips, ssim=diffusionguard_ssim, psnr=diffusionguard_psnr, vifp=diffusionguard_vifp,\n",
    "        compression_lpips=diffusionguard_compressed_lpips,\n",
    "        compression_lpips_degradation=diffusionguard_compressed_lpips_degradation,\n",
    "        purification_lpips=diffusionguard_purified_lpips,\n",
    "        purification_lpips_degradation=diffusionguard_purified_lpips_degradation,\n",
    "    )\n",
    "    write_results_csv(experiment_result_save_path, diffusionguard_results)\n",
    "    \n",
    "    # ============================ Comparative Summary ============================\n",
