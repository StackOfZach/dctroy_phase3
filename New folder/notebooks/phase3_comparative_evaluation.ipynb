    "- Alpha: {photoguard_alpha}\n",
    "- Iterations: {photoguard_iters}\n",
    "\n",
    "[BASELINE 2: MIST - Pixel Space]\n",
    "- Epsilon: {mist_eps}\n",
    "- Alpha: {mist_alpha}\n",
    "- Iterations: {mist_iters}\n",
    "\n",
    "[BASELINE 3: DIFFUSIONGUARD - Pixel Space]\n",
    "- Epsilon: {diffusionguard_eps}\n",
    "- Alpha: {diffusionguard_alpha}\n",
    "- Iterations: {diffusionguard_iters}\n",
    "\n",
    "[DATASET PATHS]\n",
    "- Dataset root: {dataset_root}\n",
    "- Metadata file: {dataset_metadata_path}\n",
    "- Source image root: {dataset_img_src_path}\n",
    "- Original images dir: {dataset_img_src_orig_path}\n",
    "- Edited images dir: {dataset_img_src_edited_path}\n",
    "\n",
    "[RESULTS PATHS]\n",
    "- Results root: {results_root}\n",
