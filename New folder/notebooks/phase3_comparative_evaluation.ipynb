    "- MIST outputs: {results_mist_path}\n",
    "- DiffusionGuard outputs: {results_diffusionguard_path}\n",
    "\n",
    "\"\"\"\n",
    "\n",
    "write_log(logger, log_message, verbose=True)"
   ]
