    "## Applying Perturbation - DCTroy (Proposed Method)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9b70f422",
   "metadata": {},
   "outputs": [],
   "source": [
    "from utils.optimizer import generate_pgd_dct_protection\n",
    "from utils.jpeg_dct import jpeg_decode, tensor_to_pil\n",
    "from utils.data_controller import save_image_lossless\n",
    "from utils.evaluation import jpeg_compress, advclean\n",
    "\n",
    "img_dctroy_protected_orig_paths = []\n",
    "img_dctroy_protected_purified_orig_paths = []\n",
    "img_dctroy_protected_compressed_orig_paths = []\n",
    "\n",
    "write_log(logger, \"[DCTROY PROTECTION] Starting perturbation generation...\", verbose=True)\n",
    "\n",
    "for img_id, y, cb, cr, loss in generate_pgd_dct_protection(\n",
    "    dctroy_iters,\n",
    "    dctroy_eps,\n",
    "    dctroy_alpha,\n",
    "    current_batch,\n",
    "    dctroy_jpeg_quality,\n",
    "    vae_encoder,\n",
    "    dctroy_frequency_weight,\n",
    "):\n",
    "    # Define save paths\n",
    "    img_dctroy_protected_orig_path = Path(\n",
    "        f\"{results_dctroy_path}/protected/orig/{img_id}_dctroy_protected_orig.png\"\n",
    "    )\n",
    "    img_dctroy_protected_purified_orig_path = Path(\n",
    "        f\"{results_dctroy_path}/purified/orig/{img_id}_dctroy_purified_orig.png\"\n",
    "    )\n",
    "    img_dctroy_protected_compressed_orig_path = Path(\n",
    "        f\"{results_dctroy_path}/compressed/orig/{img_id}_dctroy_compressed_orig.png\"\n",
    "    )\n",
    "\n",
    "    # Convert DCT to image\n",
    "    protected_img = tensor_to_pil(\n",
    "        jpeg_decode(y, cb, cr, jpeg_quality=dctroy_jpeg_quality, H=512, W=512, ste=False)\n",
    "    )\n",
    "    compressed_protected_img = jpeg_compress(protected_img, quality=dctroy_jpeg_quality, verbose=False)\n",
    "    purified_protected_img = advclean(compressed_protected_img)\n",
    "\n",
    "    # Save images\n",
    "    save_image_lossless(protected_img, img_dctroy_protected_orig_path)\n",
    "    save_image_lossless(compressed_protected_img, img_dctroy_protected_compressed_orig_path)\n",
    "    save_image_lossless(purified_protected_img, img_dctroy_protected_purified_orig_path)\n",
    "\n",
    "    img_dctroy_protected_orig_paths.append(img_dctroy_protected_orig_path)\n",
    "    img_dctroy_protected_compressed_orig_paths.append(img_dctroy_protected_compressed_orig_path)\n",
    "    img_dctroy_protected_purified_orig_paths.append(img_dctroy_protected_purified_orig_path)\n",
    "\n",
    "    log_message = f\"[DCTROY] {img_id} - Final loss: {loss:.4f}\"\n",
    "    write_log(logger, log_message, verbose=True)\n",
    "\n",
    "write_log(logger, f\"[DCTROY PROTECTION] Completed {len(img_dctroy_protected_orig_paths)} images\\n\", verbose=True)"
   ]
  },
